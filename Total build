        # Simple implementation - can be enhanced with more sophisticated metrics
        retrieved_set = set(retrieved[:self.config.top_k])
        gt_set = set(ground_truth)
        
        tp = len(retrieved_set.intersection(gt_set))
        fp = len(retrieved_set - gt_set)
        fn = len(gt_set - retrieved_set)
        
        precision = tp / (tp + fp) if (tp + fp) > 0 else 0.0
        recall = tp / (tp + fn) if (tp + fn) > 0 else 0.0
        f1 = 2 * (precision * recall) / (precision + recall) if (precision + recall) > 0 else 0.0
        
        return {
            "precision@k": precision,
            "recall@k": recall,
            "f1@k": f1,
            "tp": tp,
            "fp": fp,
            "fn": fn
        }
    
