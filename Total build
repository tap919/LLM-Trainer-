#!/usr/bin/env python3
"""
Experiment Manager - Orchestrates end-to-end experiments
"""

import os
import json
import yaml
import asyncio
import subprocess
from typing import Dict, List, Any
from datetime import datetime
from dataclasses import dataclass, field
import concurrent.futures

@dataclass
class ExperimentConfig:
    """Complete experiment configuration"""
    experiment_id: str
    base_config: Dict[str, Any]
    variants: List[Dict[str, Any]] = field(default_factory=list)
    datasets: List[Dict[str, str]] = field(default_factory=list)
    cloud_config: Dict[str, Any] = field(default_factory=dict)
    rag_config: Dict[str, Any] = field(default_factory=dict)
    
    @classmethod
    def from_file(cls, config_path: str):
        """Load experiment config from JSON file"""
        with open(config_path, "r") as f:
            data = json.load(f)
        
        return cls(
            experiment_id=data.get("experiment_id", f"exp_{datetime.now().strftime('%Y%m%d_%H%M%S')}"),
            base_config=data.get("base_config", {}),
            variants=data.get("variants", []),
            datasets=data.get("datasets", []),
            cloud_config=data.get("cloud_config", {}),
            rag_config=data.get("rag_config", {})
        )

class ExperimentManager:
    """Manages end-to-end experiment execution"""
    
    def __init__(self, config: ExperimentConfig):
        self.config = config
        self.results = {}
        self.experiment_dir = f"./results/{config.experiment_id}"
        
        # Create experiment directory
        os.makedirs(self.experiment_dir, exist_ok=True)
        
        # Save experiment config
        with open(f"{self.experiment_dir}/experiment_config.json", "w") as f:
            json.dump(self.config.__dict__, f, indent=2)
    
    def run_variant(self, variant: Dict[str, Any], variant_id: str):
        """Run a single experiment variant"""
        print(f"🔬 Running variant {variant_id}")
        
        variant_dir = f"{self.experiment_dir}/variants/{variant_id}"
        os.makedirs(variant_dir, exist_ok=True)
        
        # Save variant config
        with open(f"{variant_dir}/config.json", "w") as f:
            json.dump(variant, f, indent=2)
        
        # Prepare training config
        training_config = {**self.config.base_config.get("training", {}), **variant}
        
        # Run training
        train_script = "python/train_ray.py"
        train_args = [
            "--config", f"{variant_dir}/config.json",
            "--experiment-id", f"{self.config.experiment_id}_{variant_id}",
            "--datasets"
        ] + [ds["local"] for ds in self.config.datasets if "local" in ds]
        
        try:
            result = subprocess.run(
                [train_script] + train_args,
                capture_output=True,
                text=True,
                timeout=3600 * 4  # 4 hour timeout
            )
            
            if result.returncode == 0:
                print(f"✅ Variant {variant_id} training completed")
                
                # Run RAG evaluation if configured
                if self.config.rag_config:
                    self.run_rag_evaluation(variant, variant_id)
                
                return {
                    "success": True,
                    "variant_id": variant_id,
                    "output": result.stdout,
                    "metrics": self._extract_metrics(result.stdout)
                }
            else:
                print(f"❌ Variant {variant_id} failed: {result.stderr}")
                return {
                    "success": False,
                    "variant_id": variant_id,
                    "error": result.stderr
                }
                
        except subprocess.TimeoutExpired:
            print(f"⏱️ Variant {variant_id} timed out")
            return {
                "success": False,
                "variant_id": variant_id,
                "error": "Training timed out"
            }
        except Exception as e:
            print(f"⚠️ Variant {variant_id} error: {e}")
            return {
                "success": False,
                "variant_id": variant_id,
                "error": str(e)
            }
    
    def run_rag_evaluation(self, variant: Dict[str, Any], variant_id: str):
        """Run RAG evaluation for a variant"""
        if not self.config.rag_config:
            return
        
        print(f"🧠 Running RAG evaluation for {variant_id}")
        
        variant_dir = f"{self.experiment_dir}/variants/{variant_id}"
        
        # Prepare RAG config
        rag_config = {**self.config.rag_config, **variant.get("rag", {})}
        
        # Save RAG config
        with open(f"{variant_dir}/rag_config.json", "w") as f:
            json.dump(rag_config, f, indent=2)
        
        # Run RAG test
        rag_script = "python/rag_test.py"
        rag_args = [
            "--config", f"{variant_dir}/rag_config.json",
            "--experiment-id", f"{self.config.experiment_id}_{variant_id}_rag",
            "--data-path", self.config.datasets[0]["local"]  # First dataset for RAG
        ]
        
        if len(self.config.datasets) > 1:
            rag_args.extend(["--queries-path", self.config.datasets[1]["local"]])
        
        try:
            result = subprocess.run(
                [rag_script] + rag_args,
                capture_output=True,
                text=True,
                timeout=3600  # 1 hour timeout
            )
            
            if result.returncode == 0:
                print(f"✅ RAG evaluation completed for {variant_id}")
            else:
                print(f"⚠️ RAG evaluation failed for {variant_id}: {result.stderr}")
                
        except Exception as e:
            print(f"⚠️ RAG evaluation error for {variant_id}: {e}")
    
    def _extract_metrics(self, output: str) -> Dict[str, Any]:
        """Extract metrics from training output"""
        metrics = {}
        
        # Simple extraction - can be enhanced
        lines = output.split('\n')
        for line in lines:
            if "loss:" in line.lower():
                try:
                    parts = line.split()
                    for i, part in enumerate(parts):
                        if "loss:" in part.lower():
                            metrics["loss"] = float(parts[i + 1])
                            break
                except:
                    pass
        
        return metrics
    
    def run_parallel(self, max_workers: int = 3):
        """Run variants in parallel"""
        print(f"🚀 Starting experiment {self.config.experiment_id}")
        print(f"📊 Running {len(self.config.variants)} variants with {max_workers} workers")
        
        with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
            # Submit all variants
            future_to_variant = {
                executor.submit(self.run_variant, variant, f"variant_{i}"): f"variant_{i}"
                for i, variant in enumerate(self.config.variants)
            }
            
            # Collect results
            for future in concurrent.futures.as_completed(future_to_variant):
                variant_id = future_to_variant[future]
                try:
                    result = future.result()
                    self.results[variant_id] = result
                    
                    if result["success"]:
                        print(f"🎉 {variant_id} completed successfully")
                    else:
                        print(f"⚠️ {variant_id} failed: {result.get('error', 'Unknown error')}")
                        
                except Exception as e:
                    print(f"❌ {variant_id} generated an exception: {e}")
                    self.results[variant_id] = {
                        "success": False,
                        "error": str(e)
                    }
        
        # Save all results
        results_file = f"{self.experiment_dir}/experiment_results.json"
        with open(results_file, "w") as f:
            json.dump(self.results, f, indent=2)
        
        print(f"📁 Experiment results saved to {results_file}")
        
        # Generate insights
        self.generate_insights()
        
        return self.results
    
    def generate_insights(self):
        """Generate insights from experiment results"""
        print("💡 Generating insights...")
        
        insights_script = "python/insights_engine.py"
        insights_args = [
            "--experiment-id", self.config.experiment_id
        ]
        
        try:
            result = subprocess.run(
                [insights_script] + insights_args,
                capture_output=True,
                text=True
            )
            
            if result.returncode == 0:
                print("✅ Insights generated successfully")
            else:
                print(f"⚠️ Insights generation failed: {result.stderr}")
                
        except Exception as e:
            print(f"⚠️ Insights generation error: {e}")
    
    def deploy_to_cloud(self):
        """Deploy experiment to cloud"""
        if not self.config.cloud_config:
            print("⚠️ No cloud configuration found")
            return
        
        print("☁️ Deploying to cloud...")
        
        cloud_script = "python/cloud_orchestrator.py"
        cloud_args = [
            "--action", "deploy",
            "--name", f"{self.config.experiment_id}-train"
        ]
        
        try:
            result = subprocess.run(
                [cloud_script] + cloud_args,
                capture_output=True,
                text=True
            )
            
            if result.returncode == 0:
                print("✅ Cloud deployment successful")
            else:
                print(f"❌ Cloud deployment failed: {result.stderr}")
                
        except Exception as e:
            print(f"❌ Cloud deployment error: {e}")

def main():
    """Main experiment orchestration"""
    import argparse
    
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", type=str, required=True, help="Experiment config file")
    parser.add_argument("--local-only", action="store_true", help="Run locally only")
    parser.add_argument("--parallel", type=int, default=3, help="Max parallel runs")
    
    args = parser.parse_args()
    
    # Load experiment config
    config = ExperimentConfig.from_file(args.config)
    
    # Create manager
    manager = ExperimentManager(config)
    
    # Deploy to cloud if not local-only
    if not args.local_only:
        manager.deploy_to_cloud()
    
    # Run experiment
    results = manager.run_parallel(max_workers=args.parallel)
    
    # Print summary
    successful = sum(1 for r in results.values() if r.get("success"))
    failed = len(results) - successful
    
    print("\n" + "="*50)
    print(f"🎯 Experiment Summary:")
    print(f"   Total Variants: {len(results)}")
    print(f"   Successful: {successful}")
    print(f"   Failed: {failed}")
    print(f"   Results saved to: ./results/{config.experiment_id}/")
    print("="*50)

if __name__ == "__main__":
    main()
