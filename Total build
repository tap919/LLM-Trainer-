#!/usr/bin/env python3
"""
Distributed LLM Training using Ray on RunPod GPUs
"""

import os
import json
import yaml
import time
import torch
import wandb
import numpy as np
from dataclasses import dataclass
from typing import Dict, List, Optional, Any
from datetime import datetime

import ray
from ray import train
from ray.train import ScalingConfig, CheckpointConfig
from ray.train.torch import TorchTrainer
from ray.train.lightning import RayLightningTrainer

from datasets import load_dataset, Dataset
from transformers import (
    AutoTokenizer,
    AutoModelForCausalLM,
    TrainingArguments,
    DataCollatorForSeq2Seq,
    BitsAndBytesConfig
)
from peft import LoraConfig, TaskType, get_peft_model, prepare_model_for_kbit_training
from unsloth import FastLanguageModel, is_unsloth_available
from trl import SFTTrainer

@dataclass
class TrainingConfig:
    """Training configuration"""
    base_model: str = "moonshotai/Kimi-K2-Instruct"
    use_unsloth: bool = True
    peft_method: str = "qlora"  # qlora, dora, full
    quant_bits: int = 4  # 4, 8, 16
    max_seq_length: int = 32768
    lora_r: int = 16
    lora_alpha: int = 32
    lora_dropout: float = 0.1
    learning_rate: float = 2e-4
    num_epochs: int = 2
    batch_size: int = 2
    gradient_accumulation_steps: int = 8
    warmup_ratio: float = 0.03
    weight_decay: float = 0.01
    logging_steps: int = 10
    save_steps: int = 100
    eval_steps: int = 50
    max_grad_norm: float = 1.0

class CloudForgeTrainer:
    """Main training orchestrator"""
    
    def __init__(self, config: TrainingConfig, experiment_id: str):
        self.config = config
        self.experiment_id = experiment_id
        self.wandb_project = "cloudforge"
        
        # Initialize W&B
        wandb.init(
            project=self.wandb_project,
            name=f"{experiment_id}_{datetime.now().strftime('%Y%m%d_%H%M%S')}",
            config=config.__dict__
        )
        
        # Ray initialization will happen in the distributed context
        self.results = {}
        
    def load_and_preprocess_data(self, data_paths: List[str]) -> Dataset:
        """Load and preprocess datasets"""
        datasets = []
        
        for path in data_paths:
            if path.startswith("s3://") or path.startswith("gs://"):
                # Load from cloud storage
                dataset = load_dataset("json", data_files={"train": path})
            elif path.endswith(".jsonl") or path.endswith(".json"):
                dataset = load_dataset("json", data_files={"train": path})
            elif path.endswith(".parquet"):
                dataset = load_dataset("parquet", data_files={"train": path})
            else:
                raise ValueError(f"Unsupported format: {path}")
            
            datasets.append(dataset["train"])
        
        # Combine datasets
        if len(datasets) > 1:
            combined = datasets[0]
            for ds in datasets[1:]:
                combined = combined.concatenate(ds)
        else:
            combined = datasets[0]
        
        # Tokenize
        tokenizer = AutoTokenizer.from_pretrained(self.config.base_model)
        if tokenizer.pad_token is None:
            tokenizer.pad_token = tokenizer.eos_token
        
        def tokenize_function(examples):
            texts = examples.get("text", examples.get("input", ""))
            tokenized = tokenizer(
                texts,
                truncation=True,
                padding="max_length",
                max_length=self.config.max_seq_length
            )
            return tokenized
        
        tokenized_dataset = combined.map(
            tokenize_function,
            batched=True,
            remove_columns=combined.column_names
        )
        
        return tokenized_dataset
    
    def setup_model(self):
        """Setup model with Unsloth or standard HF"""
        if self.config.use_unsloth and is_unsloth_available():
            print("🔥 Using Unsloth for optimized training")
            model, tokenizer = FastLanguageModel.from_pretrained(
                model_name=self.config.base_model,
                max_seq_length=self.config.max_seq_length,
                dtype=torch.bfloat16,
                load_in_4bit=(self.config.quant_bits == 4),
                load_in_8bit=(self.config.quant_bits == 8),
            )
            
            # Configure LoRA
            if self.config.peft_method == "qlora":
                model = FastLanguageModel.get_peft_model(
                    model,
                    r=self.config.lora_r,
                    target_modules=["q_proj", "k_proj", "v_proj", "o_proj",
                                   "gate_proj", "up_proj", "down_proj"],
                    lora_alpha=self.config.lora_alpha,
                    lora_dropout=self.config.lora_dropout,
                    bias="none",
                    use_gradient_checkpointing="unsloth",
                    random_state=3407,
                    use_rslora=False,
                    loftq_config=None,
                )
            elif self.config.peft_method == "dora":
                # DoRA configuration
                from peft import DoRAConfig
                peft_config = DoRAConfig(
                    task_type=TaskType.CAUSAL_LM,
                    r=self.config.lora_r,
                    lora_alpha=self.config.lora_alpha,
                    lora_dropout=self.config.lora_dropout,
                )
                model = get_peft_model(model, peft_config)
        else:
            # Standard HF setup
            bnb_config = BitsAndBytesConfig(
                load_in_4bit=(self.config.quant_bits == 4),
                bnb_4bit_compute_dtype=torch.bfloat16,
                bnb_4bit_quant_type="nf4",
                bnb_4bit_use_double_quant=True,
            )
            
            model = AutoModelForCausalLM.from_pretrained(
                self.config.base_model,
                quantization_config=bnb_config if self.config.quant_bits < 16 else None,
                torch_dtype=torch.bfloat16,
                device_map="auto",
                trust_remote_code=True
            )
            
            tokenizer = AutoTokenizer.from_pretrained(self.config.base_model)
            tokenizer.pad_token = tokenizer.eos_token
            
            if self.config.peft_method in ["qlora", "dora"]:
                peft_config = LoraConfig(
                    task_type=TaskType.CAUSAL_LM,
                    r=self.config.lora_r,
                    lora_alpha=self.config.lora_alpha,
                    lora_dropout=self.config.lora_dropout,
                    bias="none",
                    target_modules=["q_proj", "k_proj", "v_proj", "o_proj",
                                  "gate_proj", "up_proj", "down_proj"],
                )
                model = prepare_model_for_kbit_training(model)
                model = get_peft_model(model, peft_config)
        
        return model, tokenizer
    
    def train_distributed(self, train_dataset, val_dataset=None):
        """Distributed training with Ray"""
        
        def train_loop_per_worker():
            # This runs on each worker
            import torch
            from torch.utils.data import DataLoader
            from transformers import Trainer, TrainingArguments
            
            # Setup model for this worker
            model, tokenizer = self.setup_model()
            
            # Training arguments
            training_args = TrainingArguments(
                output_dir=f"./results/{self.experiment_id}",
                num_train_epochs=self.config.num_epochs,
                per_device_train_batch_size=self.config.batch_size,
                gradient_accumulation_steps=self.config.gradient_accumulation_steps,
                warmup_ratio=self.config.warmup_ratio,
                weight_decay=self.config.weight_decay,
                logging_steps=self.config.logging_steps,
                save_steps=self.config.save_steps,
                eval_steps=self.config.eval_steps if val_dataset else None,
                evaluation_strategy="steps" if val_dataset else "no",
                save_strategy="steps",
                save_total_limit=3,
                load_best_model_at_end=True if val_dataset else False,
                metric_for_best_model="eval_loss",
                greater_is_better=False,
                fp16=torch.cuda.is_available(),
                bf16=False,
                max_grad_norm=self.config.max_grad_norm,
                gradient_checkpointing=True,
                gradient_checkpointing_kwargs={"use_reentrant": False},
                report_to="wandb",
                ddp_find_unused_parameters=False,
                remove_unused_columns=False,
            )
            
            # Create trainer
            trainer = Trainer(
                model=model,
                args=training_args,
                train_dataset=train_dataset,
                eval_dataset=val_dataset,
                tokenizer=tokenizer,
                data_collator=DataCollatorForSeq2Seq(
                    tokenizer=tokenizer,
                    padding=True,
                    return_tensors="pt"
                ),
            )
            
            # Train
            trainer.train()
            
            # Save final model
            trainer.save_model(f"./results/{self.experiment_id}/final")
            
            # Log final metrics
            train_metrics = trainer.evaluate()
            wandb.log(train_metrics)
            
            return train_metrics
        
        # Configure Ray distributed training
        scaling_config = ScalingConfig(
            num_workers=4,  # Adjust based on GPU count
            use_gpu=True,
            resources_per_worker={"GPU": 1},
        )
        
        checkpoint_config = CheckpointConfig(
            num_to_keep=3,
            checkpoint_score_attribute="eval_loss",
            checkpoint_score_order="min"
        )
        
        # Create Ray trainer
        ray_trainer = TorchTrainer(
            train_loop_per_worker=train_loop_per_worker,
            scaling_config=scaling_config,
            checkpoint_config=checkpoint_config,
        )
        
        # Start distributed training
        result = ray_trainer.fit()
        
        # Save results
        self.results = {
            "checkpoint_paths": [ckpt.path for ckpt in result.checkpoints],
            "metrics": result.metrics,
            "experiment_id": self.experiment_id,
            "timestamp": datetime.now().isoformat()
        }
        
        return self.results
    
    def run(self, dataset_paths: List[str]):
        """Main training pipeline"""
        print(f"🚀 Starting experiment {self.experiment_id}")
        print(f"📊 Loading {len(dataset_paths)} datasets...")
        
        # Load data
        dataset = self.load_and_preprocess_data(dataset_paths)
        
        # Split train/val
        split_dataset = dataset.train_test_split(test_size=0.1, seed=42)
        
        # Train
        print("🎯 Starting distributed training...")
        results = self.train_distributed(
            split_dataset["train"],
            split_dataset["test"]
        )
        
        print("✅ Training completed!")
        return results

def main():
    """Entry point for training"""
    import argparse
    
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", type=str, required=True)
    parser.add_argument("--experiment-id", type=str, required=True)
    parser.add_argument("--datasets", type=str, nargs="+", required=True)
    
    args = parser.parse_args()
    
    # Load config
    with open(args.config, "r") as f:
        config_data = json.load(f)
    
    config = TrainingConfig(**config_data.get("training", {}))
    
    # Initialize Ray
    ray.init(address="auto")  # Will connect to Ray cluster on RunPod
    
    # Run training
    trainer = CloudForgeTrainer(config, args.experiment_id)
    results = trainer.run(args.datasets)
    
    # Save results
    output_path = f"./results/{args.experiment_id}/training_results.json"
    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    
    with open(output_path, "w") as f:
        json.dump(results, f, indent=2)
    
    print(f"📁 Results saved to {output_path}")

if __name__ == "__main__":
    main()
