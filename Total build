#!/usr/bin/env python3
"""
Insights Engine - Analyzes experiment results and generates conclusions
"""

import os
import json
import pandas as pd
import numpy as np
from typing import Dict, List, Any, Tuple
from datetime import datetime
import matplotlib.pyplot as plt
import seaborn as sns
from dataclasses import dataclass

@dataclass
class InsightConfig:
    """Insights generation configuration"""
    metrics_to_analyze: List[str] = None
    significance_threshold: float = 0.05
    min_improvement_percent: float = 5.0
    include_cost_analysis: bool = True
    
    def __post_init__(self):
        if self.metrics_to_analyze is None:
            self.metrics_to_analyze = [
                "loss", "perplexity", "accuracy", "f1_score",
                "rag_recall", "rag_precision", "context_utilization",
                "training_time", "memory_usage", "cost"
            ]

class InsightsEngine:
    """Generates insights from experiment results"""
    
    def __init__(self, config: InsightConfig = None):
        self.config = config or InsightConfig()
        self.insights = []
        self.comparisons = {}
        
    def load_experiment(self, experiment_id: str) -> Dict[str, Any]:
        """Load experiment results"""
        experiment_dir = f"./results/{experiment_id}"
        
        if not os.path.exists(experiment_dir):
            raise FileNotFoundError(f"Experiment {experiment_id} not found")
        
        # Load results
        results_file = f"{experiment_dir}/experiment_results.json"
        with open(results_file, "r") as f:
            results = json.load(f)
        
        # Load config
        config_file = f"{experiment_dir}/experiment_config.json"
        with open(config_file, "r") as f:
            config = json.load(f)
        
        # Load individual variant results
        variants = {}
        for variant_id, result in results.items():
            variant_dir = f"{experiment_dir}/variants/{variant_id}"
            
            # Load training results
            train_results = {}
            train_file = f"{variant_dir}/training_results.json"
            if os.path.exists(train_file):
                with open(train_file, "r") as f:
                    train_results = json.load(f)
            
            # Load RAG results
            rag_results = {}
            rag_file = f"{variant_dir}/rag_results.json"
            if os.path.exists(rag_file):
                with open(rag_file, "r") as f:
                    rag_results = json.load(f)
            
            variants[variant_id] = {
                "config": result.get("config", {}),
                "success": result.get("success", False),
                "training": train_results,
                "rag": rag_results,
                "metrics": result.get("metrics", {})
            }
        
        return {
            "experiment_id": experiment_id,
            "config": config,
            "variants": variants,
            "summary": self._summarize_results(results)
        }
    
    def _summarize_results(self, results: Dict[str, Any]) -> Dict[str, Any]:
        """Create summary statistics"""
        successful = [r for r in results.values() if r.get("success")]
        failed = [r for r in results.values() if not r.get("success")]
        
        return {
            "total_variants": len(results),
            "successful": len(successful),
            "failed": len(failed),
            "success_rate": len(successful) / len(results) if results else 0
        }
    
    def compare_variants(self, experiment_data: Dict[str, Any]) -> Dict[str, Any]:
        """Compare different experiment variants"""
        variants = experiment_data["variants"]
        comparisons = {}
        
        # Create pairs for comparison
        variant_ids = list(variants.keys())
        
        for i in range(len(variant_ids)):
            for j in range(i + 1, len(variant_ids)):
                var1_id = variant_ids[i]
                var2_id = variant_ids[j]
                
                var1 = variants[var1_id]
                var2 = variants[var2_id]
                
                if not (var1["success"] and var2["success"]):
                    continue
                
                comparison = self._compare_two_variants(var1, var2)
                
                comparison_key = f"{var1_id}_vs_{var2_id}"
                comparisons[comparison_key] = comparison
        
        return comparisons
    
    def _compare_two_variants(self, var1: Dict[str, Any], var2: Dict[str, Any]) -> Dict[str, Any]:
        """Compare two variants"""
        comparison = {
            "variant1_config": var1["config"],
            "variant2_config": var2["config"],
            "metrics_comparison": {},
            "significant_differences": [],
            "recommendation": None
        }
        
        # Compare training metrics
        if var1.get("training") and var2.get("training"):
            train_metrics1 = var1["training"].get("metrics", {})
            train_metrics2 = var2["training"].get("metrics", {})
            
            for metric in self.config.metrics_to_analyze:
                if metric in train_metrics1 and metric in train_metrics2:
                    val1 = train_metrics1[metric]
                    val2 = train_metrics2[metric]
                    
                    # Calculate difference
                    if isinstance(val1, (int, float)) and isinstance(val2, (int, float)):
                        diff = val2 - val1
                        diff_percent = (diff / abs(val1)) * 100 if val1 != 0 else 0
                        
                        comparison["metrics_comparison"][metric] = {
                            "variant1": val1,
                            "variant2": val2,
                            "difference": diff,
                            "difference_percent": diff_percent,
                            "improved": self._is_improvement(metric, val1, val2)
                        }
                        
                        # Check if significant
                        if abs(diff_percent) >= self.config.min_improvement_percent:
                            comparison["significant_differences"].append({
                                "metric": metric,
                                "difference": diff_percent,
                                "direction": "improvement" if diff_percent > 0 else "regression"
                            })
        
        # Compare RAG metrics
        if var1.get("rag") and var2.get("rag"):
            rag_metrics1 = var1["rag"].get("retriever_evaluation", {})
            rag_metrics2 = var2["rag"].get("retriever_evaluation", {})
            
            for retriever in set(rag_metrics1.keys()).union(rag_metrics2.keys()):
                if retriever in rag_metrics1 and retriever in rag_metrics2:
                    for metric in ["precision@k", "recall@k", "f1@k"]:
                        val1 = rag_metrics1[retriever].get(metric, 0)
                        val2 = rag_metrics2[retriever].get(metric, 0)
                        
                        if isinstance(val1, (int, float)) and isinstance(val2, (int, float)):
                            diff = val2 - val1
                            diff_percent = (diff / val1) * 100 if val1 != 0 else 0
                            
                            metric_key = f"rag_{retriever}_{metric}"
                            comparison["metrics_comparison"][metric_key] = {
                                "variant1": val1,
                                "variant2": val2,
                                "difference": diff,
                                "difference_percent": diff_percent,
                                "improved": diff > 0
                            }
        
        # Generate recommendation
        comparison["recommendation"] = self._generate_recommendation(comparison)
        
        return comparison
    
    def _is_improvement(self, metric: str, old_val: float, new_val: float) -> bool:
        """Determine if change is an improvement"""
        # Lower is better for these metrics
        if metric in ["loss", "perplexity", "training_time", "memory_usage", "cost"]:
            return new_val < old_val
        # Higher is better for these metrics
        elif metric in ["accuracy", "f1_score", "rag_recall", "rag_precision", "context_utilization"]:
            return new_val > old_val
        else:
            return new_val > old_val  # Default to higher is better
    
    def _generate_recommendation(self, comparison: Dict[str, Any]) -> str:
        """Generate recommendation based on comparison"""
        if not comparison["significant_differences"]:
            return "No significant differences found. Both variants perform similarly."
        
        improvements = [d for d in comparison["significant_differences"] 
                       if d["direction"] == "improvement"]
        regressions = [d for d in comparison["significant_differences"] 
                      if d["direction"] == "regression"]
        
        if improvements and not regressions:
            return "Variant 2 shows clear improvements. Consider adopting this configuration."
        elif regressions and not improvements:
            return "Variant 2 shows regressions. Stick with Variant 1."
        else:
            # Mixed results
            best_improvement = max(improvements, key=lambda x: abs(x["difference"])) if improvements else None
            worst_regression = min(regressions, key=lambda x: abs(x["difference"])) if regressions else None
            
            if best_improvement and worst_regression:
                if abs(best_improvement["difference"]) > abs(worst_regression["difference"]):
                    return f"Variant 2 improves {best_improvement['metric']} by {best_improvement['difference']:.1f}%. Recommended despite minor regressions."
                else:
                    return f"Variant 2 regresses {worst_regression['metric']} by {abs(worst_regression['difference']):.1f}%. Not recommended."
        
        return "Inconclusive results. Consider running more iterations."
    
    def generate_cost_analysis(self, experiment_data: Dict[str, Any]) -> Dict[str, Any]:
        """Generate cost analysis"""
        variants = experiment_data["variants"]
        cost_analysis = {}
        
        for variant_id, variant in variants.items():
            if not variant["success"]:
                continue
            
            # Estimate costs
            training_time = variant["metrics"].get("training_time_hours", 2)
            gpu_hourly_cost = 2.10  # RTX A6000 default
            data_transfer_cost = 0.05  # per GB
            
            estimated_cost = training_time * gpu_hourly_cost
            
            cost_analysis[variant_id] = {
                "training_time_hours": training_time,
                "gpu_cost_per_hour": gpu_hourly_cost,
                "estimated_total_cost": estimated_cost,
                "cost_per_million_tokens": estimated_cost / 1000,  # Approximate
                "cost_effective": estimated_cost < 10  # Under $10 is cost-effective
            }
        
        # Find most cost-effective variant
        if cost_analysis:
            most_cost_effective = min(cost_analysis.items(), 
                                     key=lambda x: x[1]["estimated_total_cost"])
            cost_analysis["most_cost_effective"] = {
                "variant": most_cost_effective[0],
                "cost": most_cost_effective[1]["estimated_total_cost"]
            }
        
        return cost_analysis
    
    def generate_visualizations(self, experiment_data: Dict[str, Any], output_dir: str):
        """Generate visualization plots"""
        os.makedirs(output_dir, exist_ok=True)
        
        variants = experiment_data["variants"]
        
        # Prepare data for plotting
        plot_data = []
        for variant_id, variant in variants.items():
            if not variant["success"]:
                continue
            
            metrics = variant.get("metrics", {})
            config = variant.get("config", {})
            
            plot_data.append({
                "variant": variant_id,
                "method": config.get("peft_method", "unknown"),
                "context_length": config.get("max_seq_length", 0),
                "loss": metrics.get("loss", 0),
                "training_time": metrics.get("training_time_hours", 0),
                **metrics
            })
        
        if not plot_data:
            return
        
        df = pd.DataFrame(plot_data)
        
        # 1. Loss comparison plot
        plt.figure(figsize=(10, 6))
        sns.barplot(data=df, x="variant", y="loss", hue="method")
        plt.title("Training Loss by Variant")
        plt.xticks(rotation=45)
        plt.tight_layout()
        plt.savefig(f"{output_dir}/loss_comparison.png")
        plt.close()
        
        # 2. Training time vs context length
        plt.figure(figsize=(10, 6))
        sns.scatterplot(data=df, x="context_length", y="training_time", 
                       hue="method", size="loss", sizes=(50, 200))
        plt.title("Training Time vs Context Length")
        plt.tight_layout()
        plt.savefig(f"{output_dir}/time_vs_context.png")
        plt.close()
        
        # 3. RAG performance heatmap (if available)
        rag_metrics = []
        for variant_id, variant in variants.items():
            if variant.get("rag"):
                rag_eval = variant["rag"].get("retriever_evaluation", {})
                for retriever, metrics in rag_eval.items():
                    if isinstance(metrics, dict):
                        rag_metrics.append({
                            "variant": variant_id,
                            "retriever": retriever,
                            "precision": metrics.get("precision@k", 0),
                            "recall": metrics.get("recall@k", 0),
                            "f1": metrics.get("f1@k", 0)
                        })
        
        if rag_metrics:
            rag_df = pd.DataFrame(rag_metrics)
            rag_pivot = rag_df.pivot_table(values="f1", index="variant", columns="retriever")
            
            plt.figure(figsize=(10, 6))
            sns.heatmap(rag_pivot, annot=True, fmt=".2f", cmap="YlOrRd")
            plt.title("RAG F1 Scores by Variant and Retriever")
            plt.tight_layout()
            plt.savefig(f"{output_dir}/rag_performance.png")
            plt.close()
    
    def generate_report(self, experiment_data: Dict[str, Any]) -> str:
        """Generate comprehensive insights report"""
        comparisons = self.compare_variants(experiment_data)
        cost_analysis = self.generate_cost_analysis(experiment_data)
        
        report = []
        report.append("# CloudForge Experiment Insights Report")
        report.append(f"## Experiment: {experiment_data['experiment_id']}")
        report.append(f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        report.append("")
        
        # Summary
        summary = experiment_data['summary']
        report.append("## 📊 Experiment Summary")
        report.append(f"- Total Variants: {summary['total_variants']}")
        report.append(f"- Successful: {summary['successful']} ({summary['success_rate']:.1%})")
        report.append(f"- Failed: {summary['failed']}")
        report.append("")
        
        # Key Findings
        report.append("## 🔍 Key Findings")
        
        if comparisons:
            best_comparison = None
            best_improvement = 0
            
            for comp_key, comp in comparisons.items():
                improvements = [d for d in comp.get("significant_differences", []) 
                              if d["direction"] == "improvement"]
                
                if improvements:
                    max_imp = max(improvements, key=lambda x: abs(x["difference"]))
                    if abs(max_imp["difference"]) > best_improvement:
                        best_improvement = abs(max_imp["difference"])
                        best_comparison = (comp_key, comp, max_imp)
            
            if best_comparison:
                comp_key, comp, best_imp = best_comparison
                report.append(f"### 🏆 Best Improvement Found")
                report.append(f"**Comparison:** {comp_key}")
                report.append(f"**Metric:** {best_imp['metric']}")
                report.append(f"**Improvement:** {best_imp['difference']:.1f}%")
                report.append(f"**Recommendation:** {comp.get('recommendation', 'N/A')}")
                report.append("")
        
        # Cost Analysis
        if cost_analysis and "most_cost_effective" in cost_analysis:
            most_eff = cost_analysis["most_cost_effective"]
            report.append("## 💰 Cost Analysis")
            report.append(f"**Most Cost-Effective Variant:** {most_eff['variant']}")
            report.append(f"**Estimated Cost:** ${most_eff['cost']:.2f}")
            report.append("")
        
        # Detailed Comparisons
        report.append("## 📈 Detailed Comparisons")
        
        for comp_key, comp in comparisons.items():
            report.append(f"### {comp_key}")
            
            if comp.get("significant_differences"):
                report.append("**Significant Differences:**")
                for diff in comp["significant_differences"]:
                    direction = "↑" if diff["direction"] == "improvement" else "↓"
                    report.append(f"- {diff['metric']}: {direction} {abs(diff['difference']):.1f}%")
            
            if comp.get("recommendation"):
                report.append(f"**Recommendation:** {comp['recommendation']}")
            
            report.append("")
        
        # Conclusions
        report.append("## 🎯 Conclusions")
        
        # Generate conclusions based on all comparisons
        conclusions = self._generate_conclusions(comparisons, cost_analysis)
        for conclusion in conclusions:
            report.append(f"- {conclusion}")
        
        report.append("")
        report.append("---")
        report.append("*Report generated by CloudForge Insights Engine*")
        
        return "\n".join(report)
    
    def _generate_conclusions(self, comparisons: Dict[str, Any], 
                            cost_analysis: Dict[str, Any]) -> List[str]:
        """Generate actionable conclusions"""
        conclusions = []
        
        # Analyze patterns across comparisons
        method_performance = {}
        context_length_impact = {}
        
        for comp_key, comp in comparisons.items():
            # Extract method from configs
            method1 = comp.get("variant1_config", {}).get("peft_method", "unknown")
            method2 = comp.get("variant2_config", {}).get("peft_method", "unknown")
            
            # Track which method performs better
            if comp.get("recommendation", "").startswith("Variant 2"):
                method_performance[method2] = method_performance.get(method2, 0) + 1
            elif comp.get("recommendation", "").startswith("Variant 1"):
                method_performance[method1] = method_performance.get(method1, 0) + 1
        
        # Generate method-based conclusions
        if method_performance:
            best_method = max(method_performance.items(), key=lambda x: x[1])
            conclusions.append(f"**{best_method[0]}** consistently outperformed other methods in {best_method[1]} comparisons.")
        
        # Cost-based conclusions
        if cost_analysis and "most_cost_effective" in cost_analysis:
            cost_var = cost_analysis["most_cost_effective"]["variant"]
            cost_val = cost_analysis["most_cost_effective"]["cost"]
            
            # Check if cost-effective variant also performed well
            cost_variant_performs_well = any(
                comp.get("recommendation", "").startswith(f"Variant {cost_var[-1]}")
                for comp in comparisons.values()
            )
            
            if cost_variant_performs_well:
                conclusions.append(f"**{cost_var}** is both cost-effective (${cost_val:.2f}) and high-performing.")
            else:
                conclusions.append(f"**{cost_var}** is the most cost-effective (${cost_val:.2f}) but consider performance trade-offs.")
        
        # General conclusions
        total_comps = len(comparisons)
        if total_comps > 0:
            successful_comps = sum(1 for comp in comparisons.values() 
                                 if comp.get("recommendation") and 
                                 "improvement" in comp.get("recommendation", "").lower())
            
            success_rate = successful_comps / total_comps
            if success_rate > 0.5:
                conclusions.append(f"Experimental variations were largely successful ({success_rate:.0%} showed improvements).")
            else:
                conclusions.append("Conservative configurations (baseline variants) generally performed best.")
        
        return conclusions
    
    def run(self, experiment_id: str, output_dir: str = None):
        """Run full insights pipeline"""
        if output_dir is None:
            output_dir = f"./results/{experiment_id}/insights"
        
        os.makedirs(output_dir, exist_ok=True)
        
        print(f"🧠 Generating insights for experiment: {experiment_id}")
        
        # Load experiment data
        experiment_data = self.load_experiment(experiment_id)
        
        # Generate visualizations
        print("📊 Creating visualizations...")
        self.generate_visualizations(experiment_data, output_dir)
        
        # Generate report
        print("📝 Generating report...")
        report = self.generate_report(experiment_data)
        
        # Save report
        report_file = f"{output_dir}/insights_report.md"
        with open(report_file, "w") as f:
            f.write(report)
        
        # Save comparisons as JSON
        comparisons = self.compare_variants(experiment_data)
        comparisons_file = f"{output_dir}/comparisons.json"
        with open(comparisons_file, "w") as f:
            json.dump(comparisons, f, indent=2)
        
        # Save cost analysis
        cost_analysis = self.generate_cost_analysis(experiment_data)
        cost_file = f"{output_dir}/cost_analysis.json"
        with open(cost_file, "w") as f:
            json.dump(cost_analysis, f, indent=2)
        
        print(f"✅ Insights saved to {output_dir}")
        print(f"📄 Report: {report_file}")
        
        return {
            "report": report_file,
            "comparisons": comparisons_file,
            "cost_analysis": cost_file,
            "visualizations": [
                f"{output_dir}/loss_comparison.png",
                f"{output_dir}/time_vs_context.png",
                f"{output_dir}/rag_performance.png"
            ]
        }

def main():
    """Main insights generation entry point"""
    import argparse
    
    parser = argparse.ArgumentParser()
    parser.add_argument("--experiment-id", type=str, required=True)
    parser.add_argument("--output-dir", type=str)
    
    args = parser.parse_args()
    
    # Create insights engine
    engine = InsightsEngine()
    
    # Generate insights
    results = engine.run(args.experiment_id, args.output_dir)
    
    # Print brief summary
    print("\n" + "="*50)
    print("💡 Insights Generation Complete!")
    print(f"📁 Output Directory: {results['report'].rsplit('/', 1)[0]}")
    print("="*50)

if __name__ == "__main__":
    main()
